# Copiar este archivo como .env y completar. El .env NO se sube al repositorio.
# Sin ODOO_URL, los scripts usan un Odoo simulado con datos inventados.

ODOO_URL=https://miempresa.odoo.com
ODOO_DB=miempresa
ODOO_USUARIO=usuario.bi@miempresa.com
# Contraseña del usuario o, mejor, una API key (Mi perfil -> Seguridad de la cuenta)
ODOO_PASSWORD=CAMBIAR

# Primer día con datos en Odoo (lo anterior es del sistema anterior)
ERP_DESDE=2026-01-01

# Diferencia horaria con UTC (Paraguay: -3)
UTC_OFFSET=-3
