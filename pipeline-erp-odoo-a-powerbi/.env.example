# Copiar este archivo como .env y completar. El .env NO se sube al repositorio.
# Sin ODOO_URL, el script usa un Odoo simulado con datos inventados.

ODOO_URL=https://miempresa.odoo.com
ODOO_DB=miempresa
ODOO_USUARIO=usuario.reportes@miempresa.com
# Contraseña del usuario o, mejor, una API key (Mi perfil -> Seguridad de la cuenta)
ODOO_PASSWORD=CAMBIAR

# Desde qué fecha se extrae
DESDE=2026-01-01

# Diferencia horaria con UTC (por ejemplo -3)
UTC_OFFSET=-3
