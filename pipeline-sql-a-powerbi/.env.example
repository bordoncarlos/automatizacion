# Copiar este archivo como .env y completar. El .env NO se sube al repositorio.
# Sin .env, el pipeline usa la base de demostración (datos/erp_demo.db).

# URL de conexión SQLAlchemy a la base (o réplica de solo lectura) del sistema
DB_URL=postgresql://usuario_lectura:CAMBIAR@servidor:5432/erp

# Esquema y nombres de las tablas o vistas de origen (opcional)
DB_ESQUEMA=
DB_TABLA_VENTAS=ventas
DB_TABLA_STOCK=stock_actual
