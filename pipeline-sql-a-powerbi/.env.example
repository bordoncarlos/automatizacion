# Copiar este archivo como .env y completar. El .env NO se sube al repositorio.
# Sin .env, se usa la base de demostración (datos/demo.db).

# URL de conexión SQLAlchemy a la base (mejor una réplica y un usuario de solo lectura)
DB_URL=postgresql://usuario_lectura:CAMBIAR@servidor:5432/base

# Esquema y tabla (o vista) de origen
DB_ESQUEMA=
TABLA_ORIGEN=ventas
